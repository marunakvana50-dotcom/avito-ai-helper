# Пример файла с секретами. Скопируй его в файл .env и впиши свои значения.
# ВАЖНО: сам .env в git не попадает (он в .gitignore) — это правильно.

# Токен твоего Telegram-бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=сюда_вставь_токен_бота

# Ключ доступа к нейросети Gemini (получить на aistudio.google.com)
GEMINI_API_KEY=сюда_вставь_ключ_нейросети

# Необязательно (только для деплоя на Vercel через вебхук): секретное слово,
# которым Telegram будет подписывать каждый запрос к боту. Придумай любую
# случайную строку. Защищает вебхук от поддельных запросов. Для локального
# запуска (python bot.py) не нужен.
# TELEGRAM_WEBHOOK_SECRET=придумай_случайную_строку

# Необязательно: какую модель использовать.
# gemini-3.5-flash — быстро и дёшево, отлично подходит для этой задачи (по умолчанию)
# gemini-3-pro-preview — мощнее, но дороже и медленнее
# GEMINI_MODEL=gemini-3.5-flash

# Необязательно: прокси именно для запросов к Gemini. Нужен, если в твоей
# стране Gemini API недоступен напрямую (ошибка "User location is not
# supported"). Не влияет на Telegram — тот работает как обычно.
# Формат: socks5://логин:пароль@хост:порт  или  http://логин:пароль@хост:порт
# GEMINI_PROXY_URL=socks5://логин:пароль@хост:порт
